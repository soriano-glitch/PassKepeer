{
  "name": "passkeeper",
  "version": "0.1.0-phase1",
  "private": true,
  "description": "PassKeeper — offline-only personal password manager (Phase 1 foundation, no real credentials)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:poc": "jest tests/poc --runInBand"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.25",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-libsodium": "^1.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {},
  "expo": {
    "install": {
      "exclude": [
        "react-native-libsodium"
      ]
    }
  },
  "allowScripts": {
    "react-native-libsodium@1.7.0": true
  }
}
